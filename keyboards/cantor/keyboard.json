{
    "manufacturer": "Diego Palacios",
    "keyboard_name": "cantor",
    "maintainer": "diepala",
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "bootmagic": {
        "enabled": true,
        "matrix": [0,0]
    },
    "development_board": "blackpill_f401",
    "url": "https://github.com/diepala/cantor",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "matrix_pins": {
        "direct": [
            ["B10", "A8", "B15", "B14", "B13"],
            ["B8", "B5", "B4", "B3", "A15"],
            ["A4", "A5", "A6", "A7", "B0"],
            ["A2", "A1", "A0",  null, null]
        ]
    },
    "split": {
        "enabled": true,
        "bootmagic": {
            "matrix": [4, 0]
        },
        "matrix_pins": {
            "right": {
                "direct": [
                    ["B13", "B14", "B15", "A8", "B10"],
                    ["A15", "B3", "B4", "B5", "B8"],
                    ["B0", "A7", "A6", "A5", "A4"],
                    ["A0", "A1", "A2", null, null]
                ]
            }
        },
        "serial": {
            "driver": "usart"
        }
    },
    "tapping": {
        "flow_tap_term": 100,
        "permissive_hold": true,
        "term": 200
   },
   "oneshot": {
       "tap_toggle": 5,
       "timeout": 5000
   },
   "qmk": {
       "tap_capslock_delay": 80
   },
   "transport": {
       "watchdog": true,
       "watchdog_timeout": 3000
   },
    "community_layouts": ["split_3x5_3"],
